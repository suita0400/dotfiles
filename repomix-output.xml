<file path="dot_tmux.conf">
# プレフィックスキーを Ctrl+a に変更（好みで変更してください）
set -g prefix C-t
unbind C-b
bind C-t send-prefix

# 256色 / TrueColor 対応（Neovimを使う上で必須）
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"

# マウス操作を有効化
set -g mouse on

# プラグイン設定
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'

# TPM の初期化（最下部に書く）
run '~/.tmux/plugins/tpm/tpm'
</file>

<file path="run_once_after_02-install-tools.sh">
#!/bin/bash
set -eu

echo "==> [4/4] mise 経由で Node.js, Neovim をインストール"
~/.local/bin/mise install -y

# Tmux Plugin Manager (TPM) のクローン
if [ ! -d ~/.tmux/plugins/tpm ]; then
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
fi
</file>

